GOOGLE_API_KEY=

# Optional — LangSmith tracing. Leave both blank to skip tracing entirely.
# frontend/app.py also force-disables tracing in code whenever
# LANGCHAIN_API_KEY is absent, regardless of this value.
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=
LANGCHAIN_PROJECT=portfolio-agent

# Shared password gating access to the public demo. Required — the app
# fails closed (blocks all access) if this is unset.
DEMO_PASSWORD=